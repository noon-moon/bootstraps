#!/usr/bin/env python3
"""Global skill installer for bootstraps (TASK-44.2).

Per-skill symlinks from harness discovery dirs into the canonical bootstraps
checkout. See openspec/changes/distribute-agent-skills for the contract:
selection (all/category/name), managed markers (.skilllink), copy migration
with legacy-name map, collision/shadow/dangling safety, worktree refusal,
verify-after-install, uninstall, --json-plan for the bootstrap wizard.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys

MARKER = ".skilllink"
LEGACY_NAMES = {
    "adversarial-development": "experimental-development",
    "backlog-orchestrator": "run-as-orchestrator",
}

HARNESSES = {
    "opencode": os.path.join("~", ".config", "opencode", "skills"),
    "claude-code": os.path.join("~", ".claude", "skills"),
    "codex": os.path.join("~", ".codex", "skills"),
}

class Fail(Exception):
    pass


def repo_root():
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.abspath(os.path.join(here, "..", ".."))


def skills_root():
    return os.path.join(repo_root(), "tools", "skills")


def all_bundles():
    out = []
    for category in ("roles", "flows"):
        base = os.path.join(skills_root(), category)
        if not os.path.isdir(base):
            continue
        for name in sorted(os.listdir(base)):
            if os.path.isdir(os.path.join(base, name)):
                out.append((category, name, os.path.join(base, name)))
    return out


def bundle_id(category, name):
    return f"{category}/{name}"


def select_bundles(args):
    bundles = all_bundles()
    if args.all:
        wanted = None
    elif args.category:
        wanted = {args.category}
    else:
        wanted = set(args.skills or [])
    out = []
    for category, name, path in bundles:
        if args.all or (wanted and category in wanted) or (
            isinstance(wanted, set) and name in wanted
        ):
            out.append((category, name, path))
        elif wanted and name in wanted:
            out.append((category, name, path))
    if isinstance(wanted, set) and not args.all and not args.category:
        known = {n for _, n, _ in bundles}
        missing = wanted - known
        if missing:
            raise Fail(f"unknown skill(s): {', '.join(sorted(missing))}")
    return out


def read_marker(dest):
    p = marker_path(dest)
    try:
        with open(p, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None


def marker_path(dest):
    """Marker sits BESIDE the link (dest/.skilllink-<name>.json), never inside
    the bundle: symlink writes resolve into the canonical source and would
    pollute it (found in G1 self-test)."""
    return os.path.join(os.path.dirname(dest), f"{MARKER}-{os.path.basename(dest)}.json")


def write_marker(dest, bundle_path):
    with open(marker_path(dest), "w", encoding="utf-8") as fh:
        json.dump({
            "managed": "bootstraps",
            "bundle": os.path.basename(bundle_path),
            "canonical": bundle_path,
        }, fh, indent=2)


def sorted_tree(root):
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d != "__pycache__"]
        filenames = [
            f for f in filenames
            if not f.startswith(MARKER) and f != ".DS_Store"
        ]
        for f in sorted(filenames):
            out.append(os.path.relpath(os.path.join(dirpath, f), root))
    return out


def bundle_content_hash(path):
    h = hashlib.sha256()
    for rel in sorted_tree(path):
        p = os.path.join(path, rel)
        h.update(rel.encode())
        if os.path.islink(p):
            h.update(b"<link>")
            continue
        try:
            with open(p, "rb") as fh:
                while True:
                    chunk = fh.read(65536)
                    if not chunk:
                        break
                    h.update(chunk)
        except OSError:
            h.update(b"<unreadable>")
    return h.hexdigest()


def is_worktree(path):
    """True only for git WORKTREE checkouts (not the main checkout).

    Distinguishing test: for a worktree, --git-common-dir != --git-dir
    (the per-worktree dir lives under the main repo's worktrees/). A
    --separate-git-dir main checkout has .git as a FILE but both rev-parses
    agree, so it is NOT a worktree. Resolved against `path` itself (B1)."""
    try:
        common_out = subprocess.run(
            ["git", "-C", path, "rev-parse", "--git-common-dir"],
            capture_output=True, text=True, timeout=10,
        )
        dir_out = subprocess.run(
            ["git", "-C", path, "rev-parse", "--git-dir"],
            capture_output=True, text=True, timeout=10,
        )
        if common_out.returncode != 0 or dir_out.returncode != 0:
            return False  # not a git checkout / git unavailable: no evidence
        def resolve(out):
            v = out.stdout.strip()
            if not v:
                return ""
            return v if os.path.isabs(v) else os.path.normpath(
                os.path.join(os.path.abspath(path), v)
            )
        common_real = os.path.realpath(resolve(common_out))
        gitdir_real = os.path.realpath(resolve(dir_out))
        return common_real != gitdir_real
    except (OSError, subprocess.SubprocessError):
        return False


def canonical_target(args):
    target = args.canonical or repo_root()
    target = os.path.abspath(os.path.expanduser(target))
    if not os.path.isdir(os.path.join(target, "tools", "skills")):
        raise Fail(f"not a bootstraps checkout (tools/skills missing): {target}")
    if is_worktree(target):
        raise Fail(
            f"refusing to link against a worktree: {target}\n"
            "Global skills must point at a stable canonical checkout."
        )
    return target


def bundles_in_canonical(canonical):
    out = []
    for category in ("roles", "flows"):
        base = os.path.join(canonical, "tools", "skills", category)
        if not os.path.isdir(base):
            continue
        for name in sorted(os.listdir(base)):
            if os.path.isdir(os.path.join(base, name)):
                out.append((category, name, os.path.join(base, name)))
    return out


def migrate_copy(source_bundle, dest, name):
    """Owned-copy detection: content must match the current bundle. A marker
    alone NEVER authorizes replacement (B2: stale/forged marker would destroy
    differing user content). Identical content = owned regardless of marker
    (the old copy installer wrote no marker)."""
    if bundle_content_hash(source_bundle) == bundle_content_hash(dest):
        return True
    return False


def apply_models(canonical, dest_dir, name, harness, models, log):
    """Per-role model preferences (context > defaults), applied to the
    GENERATED adapter, not the portable text (skills stay model-free).

    OpenCode: the adapter file from adapters/opencode/agents/<role>.md is
    copied into the harness agents dir with its model: line overridden when a
    context model exists. Other harnesses: preference recorded for their
    (harness-specific) configuration mechanism, verified in later work."""
    model = models.get(name) if models else None
    record = os.path.join(dest_dir, f".model-{name}.json")
    if model:
        with open(record, "w", encoding="utf-8") as fh:
            json.dump({"harness": harness, "role": name, "model": model}, fh, indent=2)
        model_str = model["primary"] if isinstance(model, dict) else model
        log(f"  model preference recorded: {name} -> {model_str}")
        if harness != "opencode":
            log(f"    note: {harness} model mechanism not yet wired; preference recorded only")
    if harness != "opencode":
        return
    adapter_name = name.replace("run-as-", "")
    adapter_src = os.path.join(canonical, "tools", "skills", "adapters", "opencode", "agents", f"{adapter_name}.md")
    if not os.path.isfile(adapter_src):
        return  # flows have no adapters
    agents_dir = _opencode_agents_dir(dest_dir)
    try:
        os.makedirs(agents_dir, exist_ok=True)
    except (OSError, FileExistsError) as exc:
        raise Fail(f"cannot create harness agents dir {agents_dir}: {exc}") from exc
    with open(adapter_src, encoding="utf-8") as fh:
        text = fh.read()
    if model:
        model_str = model["primary"] if isinstance(model, dict) else model
        lines = []
        replaced = False
        for line in text.splitlines(keepends=True):
            if line.startswith("model:") and not replaced:
                lines.append(f"model: {model_str}\n")
                replaced = True
            else:
                lines.append(line)
        if not replaced:
            lines.insert(0, f"model: {model_str}\n")
        text = "".join(lines)
        record = os.path.join(dest_dir, f".model-{name}.json")
        with open(record, "w", encoding="utf-8") as fh:
            json.dump({"harness": harness, "role": name, "model": model}, fh, indent=2)
        log(f"  model override: {name} -> {model_str}")
    dest = os.path.join(agents_dir, f"{name}.md")  # installed under the full role name
    if os.path.isfile(dest) and not os.path.islink(dest):
        # owned if a model record claims it, or content equals the canonical default
        owned = os.path.exists(record)
        if not owned:
            try:
                with open(dest, encoding="utf-8") as fh:
                    current = fh.read()
                with open(adapter_src, encoding="utf-8") as fh:
                    defaults = fh.read()
                owned = current == defaults
            except OSError:
                owned = False
        if not owned and current != text:
            raise Fail(
                f"unmanaged adapter collision: {dest}\n"
                "  It differs from what would be generated and no model record "
                "claims it. Resolve manually or remove it."
            )
    with open(dest, "w", encoding="utf-8") as fh:
        fh.write(text)
    log(f"  adapter installed: {dest}")


def _opencode_agents_dir(dest_dir):
    """Harness agents dir derived from the skills dir (…/skills -> …/agents)."""
    return os.path.join(os.path.dirname(dest_dir), "agents")


def is_managed_link(dest, canonical, dest_dir):
    """A link in the harness skills dir is managed if: it carries a readable
    .skilllink marker, points into the canonical checkout, or DANGLING
    (markers live at the target and are unreachable when the target moves —
    dangling links in our managed namespace are ours to repair; links outside
    the harness dir are never touched)."""
    marker = read_marker(dest)
    target = os.readlink(dest)
    canon_real = os.path.realpath(canonical)
    if os.path.lexists(dest) and not os.path.exists(dest):
        # dangling: ours to repair when the target looks like a bundle path
        # and any marker's canonical is consistent with the target (B2-adjacent:
        # a stale marker must not claim a foreign link)
        if "tools/skills/" not in target or not any(
            f"/{seg}/" in target for seg in ("roles", "flows")
        ):
            return False
        if marker is None:
            # no marker at all: claim only if the dangling target names the
            # SAME bundle we are installing (a foreign repo's bundle path for
            # a different skill is not ours to claim)
            dest_base = os.path.basename(dest)
            if os.path.basename(target) != dest_base:
                return False
        # Dangling links in our managed namespace: the spec's ownership rule
        # is namespace-based — links we did not create elsewhere are untouched;
        # a dangling link HERE with a bundle-shaped target is ours to repair
        # (canonical moves are the normal cause). Bounded damage: repair only
        # re-points to the current canonical bundle of the same name.
        # Markers, when present, must name the same bundle (stale marker for a
        # different bundle = refuse, B2/B4).
        if marker and marker.get("canonical"):
            marker_base = os.path.basename(os.path.normpath(marker["canonical"]))
            target_base = os.path.basename(os.path.normpath(target))
            if marker_base != target_base:
                return False
        return True
    current = os.path.realpath(dest)
    if marker and marker.get("canonical"):
        marker_canon = os.path.realpath(marker["canonical"])
        if not current.startswith(marker_canon + os.sep) and current != marker_canon:
            # link resolved elsewhere than the marker's canonical: re-targeted
            return False
    return current.startswith(canon_real + os.sep) or current.startswith(
        os.path.realpath(canonical) + os.sep
    )


def canonical_of(source_bundle):
    return os.path.abspath(os.path.join(source_bundle, "..", "..", "..", ".."))


def check_internal_symlinks(bundle_path):
    """Bundles must be self-contained regular content: any symlink inside a
    bundle is rejected at install time (design debt: internal links could
    escape the canonical checkout, e.g. into private paths)."""
    for dirpath, dirnames, filenames in os.walk(bundle_path):
        for entry in dirnames + filenames:
            full = os.path.join(dirpath, entry)
            if os.path.islink(full):
                raise Fail(
                    f"internal symlink in bundle {bundle_path}: {full}\n"
                    "  Bundles must be self-contained; remove the link."
                )


def install_one(source_bundle, dest_dir, name, harness, models, log, canonical=None):
    check_internal_symlinks(source_bundle)
    dest = os.path.join(dest_dir, name)
    os.makedirs(dest_dir, exist_ok=True)
    if os.path.islink(dest):
        current = os.path.realpath(dest)
        if is_managed_link(dest, canonical_of(source_bundle), dest_dir):
            pass  # managed; re-point below
        else:
            raise Fail(f"unmanaged symlink collision: {dest} -> {current}")
    elif os.path.isdir(dest):
        if migrate_copy(source_bundle, dest, name):
            import shutil

            shutil.rmtree(dest)
            log(f"  migrated copy -> symlink: {name}")
        else:
            raise Fail(
                f"unmanaged directory collision (content differs): {dest}\n"
                "  Resolve manually or remove it; the installer will not replace it."
            )
    elif os.path.exists(dest):
        raise Fail(f"non-directory collision: {dest}")

    tmp = dest + f".tmp.{os.getpid()}"
    if os.path.islink(tmp) or os.path.exists(tmp):
        os.remove(tmp)
    os.symlink(source_bundle, tmp)
    os.replace(tmp, dest)
    write_marker(dest, source_bundle)
    apply_models(canonical, dest_dir, name, harness, models, log)
    log(f"  linked: {dest} -> {source_bundle}")


def verify_discovery(harness, dest_dir, names, log):
    """Honest verification (B3): each installed link must resolve to a real
    bundle directory containing a SKILL.md whose frontmatter name matches.
    Filesystem-only: no harness CLI is contacted (availability varies), and
    output says so — never claim live discovery success."""
    ok = []
    for name in names:
        link = os.path.join(dest_dir, name)
        skill_md = os.path.join(link, "SKILL.md")
        problems = []
        if not os.path.isdir(link):
            log(f"  VERIFY FAILED (does not resolve): {link}")
            continue
        try:
            import re

            with open(os.path.join(link, "SKILL.md"), encoding="utf-8") as fh:
                head = fh.read(2048)
            m = re.search(r"^---\n(.*?)\n---", head, re.S)
            frontmatter = m.group(1) if m else head
            if not re.search(rf"^name:\s*{re.escape(name)}\s*$", frontmatter, re.M):
                log(f"  VERIFY FAILED (SKILL.md frontmatter name mismatch) in {name}")
                continue
        except OSError as exc:
            log(f"  VERIFY FAILED (unreadable SKILL.md) {name}: {exc}")
            continue
        ok.append(name)
    if ok:
        log(f"  verified (filesystem-only): {len(ok)}/{len(names)} resolve with matching SKILL.md names")
        log("  note: restart the harness session to load/reload skills; live discovery not probed")
    return ok


SHADOW_DISCOVERY_DIRS = (".opencode", ".claude", ".codex")
SHADOW_MAX_DEPTH = 6


def find_shadows(canonical, harness_dir, installed_names, log):
    """Report project-local skills shadowing a globally installed name.

    Bounded: scan only harness discovery dirs (.opencode/.claude/.codex/skills)
    within MAX DEPTH levels below cwd, excluding the harness dir and the
    canonical checkout (B5: the unbounded cwd walk stalled and was noise).
    Runs once per invocation."""
    shadows = []
    seen = set()
    canonical_real = os.path.realpath(canonical)
    harness_real = os.path.realpath(harness_dir)
    base = os.path.abspath(os.getcwd())
    for discovery in SHADOW_DISCOVERY_DIRS:
        # walk <cwd> down to depth, looking for <cwd-segments>/<discovery>/skills
        stack = [(base, 0)]
        while stack:
            dirpath, depth = stack.pop()
            if depth > SHADOW_MAX_DEPTH:
                continue
            real = os.path.realpath(dirpath)
            if real == harness_real or real.startswith(harness_real + os.sep):
                continue
            if real == canonical_real or real.startswith(canonical_real + os.sep):
                continue
            for name in installed_names:
                candidate = os.path.join(dirpath, discovery, "skills", name, "SKILL.md")
                if os.path.isfile(candidate) and os.path.join(dirpath, discovery, "skills", name) not in shadows:
                    shadows.append(os.path.join(dirpath, discovery, "skills", name))
            if depth < SHADOW_MAX_DEPTH:
                try:
                    entries = os.listdir(dirpath)
                except OSError:
                    continue
                for entry in entries:
                    if entry.startswith("."):
                        continue
                    sub = os.path.join(dirpath, entry)
                    if os.path.isdir(sub) and not os.path.islink(sub):
                        stack.append((sub, depth + 1))
    for s in shadows:
        log(f"  SHADOW: {s} shadows a globally installed skill")
    return shadows


def migrate_legacy_names(dest_dir, canonical, log, selected_names=None):
    """Legacy-name migration: an installed copy under a legacy name whose
    content matches the current bundle is replaced by the new-name symlink
    and the old name removed, with the map printed (spec R: migration map)."""
    for legacy, current in LEGACY_NAMES.items():
        legacy_path = os.path.join(dest_dir, legacy)
        if not os.path.exists(legacy_path):
            continue
        if selected_names is not None and current not in selected_names:
            # N7: never delete a legacy copy without installing its
            # replacement in the same run
            log(f"  legacy: {legacy} present but {current} not selected this run; left in place")
            continue
        current_link = os.path.join(dest_dir, current)
        if os.path.islink(current_link) or os.path.exists(current_link):
            log(f"  legacy: {legacy} still present alongside {current}; remove it (map: {legacy} -> {current})")
            continue
        source = find_bundle_by_name(canonical, current)
        if source and bundle_content_hash(source) == bundle_content_hash(legacy_path):
            import shutil

            shutil.rmtree(legacy_path)
            log(f"  legacy migrated: {legacy} -> {current} (copy removed; install {current} separately)")
        else:
            log(f"  legacy: {legacy} differs from current {current}; left in place for manual review")


def find_bundle_by_name(canonical, name):
    for category in ("roles", "flows"):
        p = os.path.join(canonical, "tools", "skills", category, name)
        if os.path.isdir(p):
            return p
    return None


def main(argv=None):
    ap = argparse.ArgumentParser(prog="install-skills")
    ap.add_argument("--all", action="store_true", help="install every bundle")
    ap.add_argument("--category", choices=["roles", "flows"], help="whole category")
    ap.add_argument("--skills", nargs="*", help="specific skill names")
    ap.add_argument(
        "--harness", nargs="*", default=["opencode"],
        help="targets: opencode claude-code codex (default: opencode)",
    )
    ap.add_argument("--canonical", help="canonical bootstraps checkout (default: this repo)")
    ap.add_argument("--models", help="path to context models.json (per-role overrides)")
    ap.add_argument("--uninstall", action="store_true", help="remove managed links")
    ap.add_argument(
        "--json-plan", action="store_true",
        help="emit selection JSON for the bootstrap wizard and exit",
    )
    args = ap.parse_args(argv)

    log = lambda msg: print(msg)

    if args.json_plan:
        if args.canonical:
            canonical_target(args)  # validate when explicitly given (N8)
        plan = {
            "skills": [name for _, name, _ in all_bundles()],
            "harnesses": list(HARNESSES),
            "selection_schema": {
                "skills": "list[str]", "harnesses": "list[str]",
                "canonical": "path", "models": "path|none",
            },
        }
        print(json.dumps(plan, indent=2))
        return 0

    try:
        canonical = canonical_target(args)
        bundles = bundles_in_canonical(canonical)
        selected = select_bundles(args)
        if not selected:
            ap.error("nothing selected: use --all, --category, or --skills")
    except Fail as exc:
        log(f"install-skills: {exc}")
        return 1

    models = {}
    if args.models:
        try:
            with open(os.path.expanduser(args.models), encoding="utf-8") as fh:
                models = json.load(fh)
        except (OSError, json.JSONDecodeError) as exc:
            log(f"install-skills: invalid models file: {exc}")
            return 3

    failures = 0
    for harness in args.harness:
        if harness not in HARNESSES:
            log(f"install-skills: unknown harness '{harness}' (known: {', '.join(HARNESSES)})")
            failures += 1
            continue
        dest_dir = os.path.expanduser(HARNESSES[harness])
        log(f"harness {harness}: {dest_dir}")
        installed = []
        if not args.uninstall:
            migrate_legacy_names(dest_dir, canonical, log, selected_names={n for _, n, _ in selected})
        for category, name, _ in selected:
            source = os.path.join(canonical, "tools", "skills", category, name)
            if not os.path.isdir(source):
                log(f"  FAIL: bundle missing in canonical checkout: {category}/{name}")
                failures += 1
                continue
            try:
                if args.uninstall:
                    dest = os.path.join(dest_dir, name)
                    marker = read_marker(dest)
                    removed_any = False
                    if os.path.islink(dest) and (marker or os.path.realpath(dest).startswith(canonical)):
                        os.remove(dest)
                        removed_any = True
                    elif os.path.exists(dest) and not os.path.islink(dest):
                        log(f"  SKIP unmanaged: {dest}")
                    mp = marker_path(dest)
                    if marker and os.path.exists(mp):
                        os.remove(mp)  # orphan marker (link already gone)
                        removed_any = True
                    mrec = os.path.join(dest_dir, f".model-{name}.json")
                    owned_model = os.path.exists(mrec)
                    adapter_name = name.replace("run-as-", "")
                    adapter_dest = os.path.join(
                        os.path.dirname(dest_dir), "agents", f"{name}.md"
                    )
                    adapter_src = os.path.join(
                        canonical, "tools", "skills", "adapters", "opencode",
                        "agents", f"{adapter_name}.md"
                    )
                    if owned_model and os.path.isfile(adapter_dest):
                        os.remove(adapter_dest)
                        removed_any = True
                    elif (
                        os.path.isfile(adapter_dest)
                        and os.path.isfile(adapter_src)
                        and open(adapter_dest, encoding="utf-8").read()
                        == open(adapter_src, encoding="utf-8").read()
                    ):
                        os.remove(adapter_dest)  # unmodified default: ours
                        removed_any = True
                    elif os.path.isfile(adapter_dest):
                        log(f"  adapter left (unowned/differing): {adapter_dest}")
                    if os.path.exists(mrec):
                        os.remove(mrec)  # model record managed by installer
                        removed_any = True
                    if removed_any:
                        log(f"  removed: {name}")
                    elif not os.path.exists(dest):
                        log(f"  not present: {name}")
                else:
                    install_one(source, dest_dir, name, harness, models, log, canonical=canonical)
                    installed.append(name)
            except Fail as exc:
                log(f"  FAIL: {exc}")
                failures += 1
        if installed and not args.uninstall:
            shadows = find_shadows(canonical, dest_dir, installed, log)
            ok = verify_discovery(harness, dest_dir, installed, log)
            log(f"  verified discovery: {len(ok)}/{len(installed)}")

    log("done" if not failures else f"done with {failures} failure(s)")
    return 0 if not failures else 1


if __name__ == "__main__":
    sys.exit(main())